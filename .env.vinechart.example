# VineChart authorized upstream API
# Do not commit real credentials.

VINECHART_BASE_URL=https://vinechart.com
VINECHART_STATUS_PATH=/api/status
VINECHART_SERIES_PATH=/api/series

# Set this only after confirming the authorized SSE path in VineChart's docs.
# VINECHART_SSE_PATH=/api/events

# Supported by the adapter: none | headers | bearer | basic
# Use the mode documented/approved by VineChart.
VINECHART_AUTH_MODE=none

# VineChart authorized the project to create its own client credentials.
# Fill these locally once the exact transport/header convention is confirmed.
VINECHART_CLIENT_ID=
VINECHART_CLIENT_SECRET=
VINECHART_API_KEY=

# Override only if VineChart documents different header names.
VINECHART_CLIENT_ID_HEADER=X-Client-ID
VINECHART_CLIENT_SECRET_HEADER=X-Client-Secret
VINECHART_API_KEY_HEADER=X-API-Key

VINECHART_REQUEST_TIMEOUT_MS=10000
VINECHART_USER_AGENT=VineScout/0.1 (authorized VineChart client)
